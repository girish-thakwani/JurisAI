# source: sheet | csv        channel: whatsapp_web | dry_run
SOURCE=sheet
CHANNEL=whatsapp_web

SHEET_URL=https://docs.google.com/spreadsheets/d/<id>/edit
CREDS_FILE=creds.json
CSV_PATH=contacts.csv

# message text, or point MESSAGE_FILE at a .txt file
MESSAGE=https://chat.whatsapp.com/<invite-code>
MESSAGE_FILE=

CDP_URL=http://localhost:9222
DEFAULT_COUNTRY_CODE=91

# policy (defaults shown)
MAX_ATTEMPTS=3
ROW_RETRIES=2
MAX_OFFLINE_WAIT=1800
PENDING_WAIT=300
BATCH_SIZE=20
BATCH_PAUSE_MIN=300
BATCH_PAUSE_MAX=600
MAX_PER_RUN=250
MAX_CONSECUTIVE_FAILS=5
DELAY_MIN=2
DELAY_MAX=5
